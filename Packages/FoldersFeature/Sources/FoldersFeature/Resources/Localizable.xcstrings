{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%lld songs": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld song"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld songs"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld песня"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld песни"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld песен"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld песни"
                }
              }
            }
          }
        }
      }
    },
    "%lld songs are inside. Delete them from the device or keep them in the library?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Песен внутри: %lld. Удалить их с устройства или оставить в медиатеке?"
          }
        }
      }
    },
    "A folder can’t be moved into itself or one of its subfolders.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папку нельзя переместить в саму себя или во вложенную папку."
          }
        }
      }
    },
    "Actions": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действия"
          }
        }
      }
    },
